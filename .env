# Local POC config — the ONLY configuration source (no appsettings.json).
# Fully local, fake credentials by design.

POSTGRES_DB=blog
POSTGRES_PASSWORD=fga
POSTGRES_PORT=5435
# --- Postgres (shared by OpenFGA and the blog) ---
POSTGRES_USER=fga

# --- Blog database (Dapper / Npgsql) ---
BLOG_DB_CONNECTION=Host=localhost;Port=5435;Database=blog;Username=fga;Password=fga

# --- OpenFGA ---
FGA_API_URL=http://localhost:8080
FGA_STORE_NAME=fga-blog-poc

OKTA_FGA_API_AUDIENCE=
OKTA_FGA_API_TOKEN_ISSUER=
# --- Okta FGA (hosted OpenFGA; same wire API, so it reuses the OpenFGA client) ---
# Unset by default. Fill these in and set AUTHORIZATION_PROVIDER=oktafga to use it.
OKTA_FGA_API_URL=
OKTA_FGA_CLIENT_ID=
# Real secret when set — do not commit a populated value.
OKTA_FGA_CLIENT_SECRET=
OKTA_FGA_STORE_NAME=fga-blog-poc

# --- Amazon Verified Permissions ---
AVP_POLICY_STORE_ID=policy-store-alias/fga-blog-poc
# Uses the normal AWS SDK credential chain; never put AWS credentials in this file.
AWS_REGION=us-east-2

# --- App ---
ASPNETCORE_URLS=http://localhost:5080
AUTHORIZATION_PROVIDER=openfga
